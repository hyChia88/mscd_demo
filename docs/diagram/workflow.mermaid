flowchart LR
  %% ---------------- BEFORE ----------------
  subgraph B["Before: fragmented and manual workflow"]
    direction TB

    B1["Site Evidence
    photos
    chat messages
    marked floorplans
    handwritten forms"]

    B2["Construction Manager
    manually interprets
    and re-enters data"]

    B3["BIM / CDE / project record
    updated late
    weak linkage to IFC element / GUID"]

    B4["Developers / regulators / project team
    read stale or weakly traceable status"]

    B1 -->|"heterogeneous inputs"| B2
    B2 -->|"manual translation"| B3
    B3 -->|"delayed / partial update"| B4
  end

  %% ---------------- AFTER ----------------
  subgraph A["After: interpreter-streamlined interoperable workflow"]
    direction TB

    A1["Site Evidence
    photos
    chat messages
    floorplans
    field notes"]

    A2["AEC Interpreter Layer
    multimodal parsing
    IFC grounding
    schema alignment"]

    A3["Structured interoperable record
    IFC-linked reference / GUID
    normalized fields
    validated handoff"]

    A4["BIM / CDE / dashboard / compliance workflow
    faster update
    traceable status
    evidence-backed coordination"]

    A1 -->|"messy inputs preserved"| A2
    A2 -->|"standardized, grounded output"| A3
    A3 -->|"machine-usable interoperable flow"| A4
  end

  %% Side knowledge inputs to interpreter
  K1["IFC model / graph"]
  K2["project metadata / 4D context"]
  K3["schema / reporting template"]

  K1 -.-> A2
  K2 -.-> A2
  K3 -.-> A2

  %% Outcome callouts
  O1["Reduced information loss"]
  O2["Improved interoperability"]
  O3["Evidence-to-GUID traceability"]
  O4["CM shifts from data entry to verification"]

  A4 --> O1
  A4 --> O2
  A4 --> O3
  A4 --> O4

  %% Styling
  classDef before fill:#fdeaea,stroke:#c94f4f,color:#222;
  classDef after fill:#eaf4ff,stroke:#4a86c5,color:#222;
  classDef outcome fill:#e9f6ea,stroke:#5f9c63,color:#222;
  classDef knowledge fill:#f5f5f5,stroke:#999,color:#222;

  class B1,B2,B3,B4 before;
  class A1,A2,A3,A4 after;
  class O1,O2,O3,O4 outcome;
  class K1,K2,K3 knowledge;
