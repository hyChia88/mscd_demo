@startuml MSCD_Demo_System_Architecture
!theme plain
title **MSCD Demo -- System Architecture**\n//Neuro-Symbolic IFC Element Retrieval System//

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam ArrowThickness 1.5
skinparam RoundCorner 8
skinparam shadowing false

skinparam package<<input>> {
    BackgroundColor #E8F5E9
}
skinparam package<<v1>> {
    BackgroundColor #FFF3E0
}
skinparam package<<v2>> {
    BackgroundColor #E3F2FD
}
skinparam package<<retrieval>> {
    BackgroundColor #F3E5F5
}
skinparam package<<postprocess>> {
    BackgroundColor #FFEBEE
}
skinparam package<<external>> {
    BackgroundColor #F5F5F5
}

' ── INPUT ──────────────────────────────────────────────────────────
package "Input" <<input>> {
    component "Ground Truth\nDataset" as GT
    component "Site Images\n+ Floorplans" as IMAGES
    component "config.yaml\nprofiles.yaml" as CONFIG
}

' ── V1 ─────────────────────────────────────────────────────────────
package "V1 Pipeline (Agent-Driven)" <<v1>> {
    component "**LangGraph\nReAct Agent**" as V1_AGENT
    component "IFC Query\nMCP Server" as IFC_MCP
    component "Visual\nMCP Server" as VIS_MCP
}

' ── V2 ─────────────────────────────────────────────────────────────
package "V2 Pipeline (Neuro-Symbolic, Constraints-Driven)" <<v2>> {
    component "**ConditionMask**\nAblation A1-C3" as COND_MASK
    component "**ImageParser**\nGemini VLM\n(prompt path only)" as IMG_PARSER
    component "**LoRA_3**\nQwen2.5-VL-7B\n(lora path only)" as LORA
    component "**ConstraintsExtractor**\nConstraints + SpatialTriplet[]" as CONSTRAINTS
    component "**QueryPlanner**\nP0 spatial_triplet\nP1 space+type / P2 name_keyword\nP3 neighbor+type / P4 storey+type\nP5-P8 coarse fallback" as QUERY_PLAN
}

' ── RETRIEVAL ───────────────────────────────────────────────────────
package "Retrieval & Engine" <<retrieval>> {
    component "**RetrievalBackend**\nCascade P0 -> P8\nuntil pool > 0" as RET_BACK
    component "**IFCEngine**\nSpatial index\nmemory mode" as IFC_ENGINE
    component "**VisualAligner**\nCLIP reranking" as CLIP
}

' ── POST-PROCESSING ─────────────────────────────────────────────────
package "Post-processing & Output" <<postprocess>> {
    component "**Evaluation**\nTop-1/5, P@1, Recall, F1" as EVAL_MOD
    component "**RQ2 + BCF**\nSchema validation" as RQ2
    artifact "outputs/ + logs/" as OUT
}

' ── EXTERNAL ────────────────────────────────────────────────────────
package "External Services" <<external>> {
    cloud "**Google Gemini**\nLLM + VLM" as LLM
    database "**Neo4j**\nFILLS, CONTAINS\nADJACENT_TO" as NEO4J
    component "**IFC Model**\nAdvancedProject.ifc" as IFC_FILE
    component "**CLIP Model**\nHuggingFace" as HF_CLIP
}

' ── RUNNER ──────────────────────────────────────────────────────────
component "**run.py**\nUnified Runner" as RUNNER

' ── RELATIONSHIPS ───────────────────────────────────────────────────

' Input
GT     --> RUNNER
IMAGES --> RUNNER
CONFIG --> RUNNER

' Runner -> pipelines
RUNNER --> V1_AGENT  : pipeline == "v1"
RUNNER --> COND_MASK : pipeline == "v2"

' V1 flow
V1_AGENT --> IFC_MCP
V1_AGENT --> VIS_MCP
V1_AGENT --> LLM : ReAct loop
IFC_MCP  --> IFC_ENGINE
VIS_MCP  --> CLIP

' V2 Step 1 -- mask -> two paths
COND_MASK --> IMG_PARSER  : masked_case\n[prompt path]
COND_MASK --> CONSTRAINTS : raw images + text\n[lora path]

' V2 Step 2 -- prompt path: IMG_PARSER -> LLM -> CONSTRAINTS
IMG_PARSER --> LLM         : VLM image parse
LLM        --> CONSTRAINTS : ImageParseResult\n+ JSON extraction\n[prompt path]

' V2 Step 2 -- lora path: CONSTRAINTS -> LORA -> CONSTRAINTS
CONSTRAINTS --> LORA : inference(images, prompt)\n[lora path]
LORA --> CONSTRAINTS : SpatialTriplet[]\n+ Constraints JSON\n[lora path]

' V2 Step 3 -- plan -> retrieve
CONSTRAINTS --> QUERY_PLAN : Constraints
QUERY_PLAN  --> RET_BACK   : QueryPlan[] P0->P8

' Retrieval backends
RET_BACK --> IFC_ENGINE : memory mode
RET_BACK --> NEO4J      : neo4j mode\n(P0 FILLS/ADJACENT_TO)
RET_BACK --> CLIP       : reranking

' Engine
IFC_ENGINE --> IFC_FILE
CLIP       --> HF_CLIP

' Post-processing
RET_BACK   --> EVAL_MOD
V1_AGENT   --> RQ2
QUERY_PLAN ..> RQ2
EVAL_MOD   --> OUT

legend bottom left
  |= Color |= Layer |
  |<#E8F5E9> | Input |
  |<#FFF3E0> | V1 -- ReAct Agent + MCP |
  |<#E3F2FD> | V2 -- Neuro-Symbolic (LoRA / Gemini) |
  |<#F3E5F5> | Retrieval & Engine |
  |<#FFEBEE> | Post-processing & Output |
  |<#F5F5F5> | External Services |
end legend

@enduml
